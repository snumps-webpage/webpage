# Auth.js 설정
AUTH_SECRET=your-secret-key-here  # openssl rand -base64 32 로 생성

# Google OAuth 설정
# Google Cloud Console에서 OAuth 2.0 클라이언트 ID 생성 후 입력
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Notion API 설정 (이주 완료 시 제거 예정)
# https://www.notion.so/my-integrations 에서 Integration 생성 후 입력
NOTION_API_KEY=secret_xxxxxx
NOTION_DATABASE_ID=xxxxxxxx

# AWS S3 데이터 계층 (docs/spec/IMPLEMENTATION-SPEC.md Phase 0)
AWS_REGION=ap-northeast-2
S3_DATA_BUCKET=snumps-data-private
S3_ASSETS_BUCKET=snumps-assets
ASSETS_CDN_URL=https://xxxx.cloudfront.net
# OIDC 사용 시: 역할 ARN만 설정 (장기 키 불요, 권장)
AWS_ROLE_ARN=
# 키 방식 폴백 (OIDC 미사용 시에만)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 크론 인증 — 미설정 시 /api/cron/* 은 501 (fail-closed)
CRON_SECRET=

# 메일 본문의 링크(옵트아웃 등)에 쓰는 사이트 원본 URL
PUBLIC_SITE_ORIGIN=https://snumps.vercel.app

# Redis 캐시 (선택 — 없으면 메모리 캐시만)
REDIS_URL=
