# Auth.js 설정
AUTH_SECRET=your-secret-key-here  # openssl rand -base64 32 로 생성

# Google OAuth 설정
# Google Cloud Console에서 OAuth 2.0 클라이언트 ID 생성 후 입력
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Notion API 설정
# https://www.notion.so/my-integrations 에서 Integration 생성 후 입력
NOTION_API_KEY=secret_xxxxxx
NOTION_DATABASE_ID=xxxxxxxx
