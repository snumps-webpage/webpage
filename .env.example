# Auth.js 설정
AUTH_SECRET=your-secret-key-here  # openssl rand -base64 32 로 생성

# Google OAuth 설정
# Google Cloud Console에서 OAuth 2.0 클라이언트 ID 생성 후 입력
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Notion API 설정 (이주 완료 시 제거 예정)
# https://www.notion.so/my-integrations 에서 Integration 생성 후 입력
NOTION_API_KEY=secret_xxxxxx
NOTION_DATABASE_ID=xxxxxxxx

# Supabase 데이터 계층 (docs/spec/SUPABASE-MIGRATION-SPEC.md §6)
# prod / dev 프로젝트별로 각각 발급 — 로컬 개발은 dev 프로젝트 값 사용 (docs/SETUP.md "로컬 개발")
SUPABASE_URL=https://xxxx.supabase.co
# 신 체계 sb_secret_... 키 (legacy service_role JWT 아님 — 2026년 말 deprecate 예고). 서버 전용, 절대 커밋 금지
SUPABASE_SECRET_KEY=sb_secret_xxxxxx
SUPABASE_ASSETS_BUCKET=assets
SUPABASE_STAGING_BUCKET=staging
SUPABASE_BACKUPS_BUCKET=backups

# 자산 공개 URL 베이스 — assets 버킷의 public URL (assetUrl()이 앞에 붙임)
ASSETS_CDN_URL=https://xxxx.supabase.co/storage/v1/object/public/assets

# Healthchecks.io dead-man's switch — 크론 성공 시 핑 1회 (스펙 §5-3)
HEALTHCHECKS_PING_URL=

# 주간 백업의 off-platform 사본 (스펙 §7 B2)
GITHUB_BACKUP_REPO=snumps-webpage/snumps-backups
# fine-grained PAT — 해당 repo contents:write 권한 한정
GITHUB_BACKUP_TOKEN=

# 데이터 백엔드: supabase | memory
# memory는 dev 오프라인 보조용 (S4) — 프로세스 재시작 시 데이터 소멸, 가짜(시드) 데이터 주의
DATA_BACKEND=supabase

# 크론 인증 — 미설정 시 /api/cron/* 은 501 (fail-closed)
CRON_SECRET=

# 메일 본문의 링크(옵트아웃 등)에 쓰는 사이트 원본 URL
PUBLIC_SITE_ORIGIN=https://snumps.vercel.app

# Redis 캐시 (선택 — 없으면 메모리 캐시만)
REDIS_URL=
