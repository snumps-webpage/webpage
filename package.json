{
  "name": "snumps-webpage",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": ">=22",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --output=machine-verbose",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --ignore-unknown . && eslint .",
    "format": "prettier --write --ignore-unknown .",
    "deploy": "vercel build --prod && vercel deploy --prebuilt --prod",
    "deploy:preview": "vercel build && vercel deploy --prebuilt"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.2.2",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.9.6",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@auth/sveltekit": "^1.11.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.50.2",
    "html-to-image": "^1.11.13",
    "svelte": "^5.50.0",
    "uuid": "^14.0.2",
    "vite": "^7.3.1",
    "zod": "^4.4.3"
  }
}
